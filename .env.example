APP_NAME="MáToCenu.cz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8100
APP_TIMEZONE=Europe/Prague

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL (docker compose service "pgsql"; host port 54333 for tests / tinker on the host)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54333
DB_DATABASE=matocenu
DB_USERNAME=matocenu
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=63792

# Local: Mailpit (http://127.0.0.1:8025). Production: real SMTP.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@matocenu.cz"
MAIL_FROM_NAME="${APP_NAME}"

# Google login (Socialite). Leave empty = button hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# AI – API keys are entered in Administrace → AI poskytovatelé (stored encrypted with APP_KEY).
# An env key, if present, is used as a fallback for the provider with the same slug.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# HMAC secret for privacy-preserving AI cache keys (defaults to APP_KEY).
AI_CACHE_HMAC_KEY=

# Docker host bindings
MTC_HTTP_BIND=127.0.0.1
MTC_HTTP_PORT=8100
MTC_DB_PORT=54333
MTC_REDIS_PORT=63792
MTC_MAILPIT_PORT=8025

VITE_APP_NAME="${APP_NAME}"
